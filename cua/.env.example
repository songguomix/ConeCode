# Real-model provider (only needed for a real-model run; never commit a key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Select a model available to your provider/project; no model is hard-coded.
CUA_REAL_MODEL=

# Set CUA_RUN_REAL_MODEL=1 to enable the opt-in real-model vitest case.
CUA_RUN_REAL_MODEL=0

# Local service / SDK / MCP client
CUA_API_URL=http://127.0.0.1:4317
# CUA_TOKEN=replace-with-the-token-from-.cua/server-token
CUA_DATA_DIR=./.cua
# Docker only: allow wildcard bind while retaining loopback Host/Origin checks.
# Keep the published host port bound to 127.0.0.1:4317.
CUA_ALLOW_NON_LOOPBACK_BIND=0

# Optional: include screenshots in planner requests when the model supports images.
# The runtime defaults to structured observations plus screenshots every third step
# only when the adapter is explicitly configured with capabilities.images=true.
CUA_SEND_SCREENSHOTS=1

# Long-term workflow reuse expires after this age (default seven days).
CUA_WORKFLOW_MAX_AGE_MS=604800000
