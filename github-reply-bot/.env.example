# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# SQLite file path. `file:` prefix is optional. Relative paths resolve from the
# directory the server is started in.
DATABASE_URL=file:./data/reply-bot.db

# ---------------------------------------------------------------------------
# Dashboard authentication (REQUIRED)
# Long random string, e.g. `openssl rand -hex 32`. Without it the dashboard and
# its API answer 503 and the server logs that admin auth is not configured.
# ---------------------------------------------------------------------------
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# GitHub App (REQUIRED for real webhooks / publishing)
# Create the App per README -> "GitHub App 创建步骤".
# GITHUB_PRIVATE_KEY may contain literal newlines or escaped `\n` sequences.
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# App slug, used to detect `@<slug>` mentions. Example: my-reply-bot
GITHUB_APP_SLUG=

# ---------------------------------------------------------------------------
# Optional LLM generator (disabled unless generator_provider=http_llm)
# Must be an OpenAI-compatible POST endpoint that accepts {model, messages}.
# When http_llm is selected without LLM_ENDPOINT the settings API returns a
# configuration error instead of silently falling back.
# ---------------------------------------------------------------------------
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Queue polling and retention cleanup (optional)
# ---------------------------------------------------------------------------
WORKER_INTERVAL_MS=1000
RETENTION_SWEEP_INTERVAL_MS=3600000
