{
  "name": "github-reply-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted GitHub App that drafts and posts replies to issues and pull requests",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsup src/server/index.ts --format esm --platform node --target node20 --out-dir dist/server --external better-sqlite3 --sourcemap",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:migrate": "tsx src/server/db/cli.ts migrate",
    "db:seed": "tsx src/server/db/cli.ts seed"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@octokit/app": "^16.0.1",
    "@octokit/rest": "^22.0.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
