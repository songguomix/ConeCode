{
  "name": "conecode",
  "version": "2.4.1",
  "description": "AI Desktop Client",
  "author": "ConeCode",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron .",
    "pack": "npm run build && electron-builder --mac",
    "dist": "npm run build && electron-builder --mac --publish=never",
    "dist:mac:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish=never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish=never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish=never",
    "dist:all": "npm run build && electron-builder -mw --publish=never"
  },
  "build": {
    "appId": "com.conecode.app",
    "productName": "ConeCode",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "resources/bin/cloudflared-darwin-arm64",
          "to": "bin/cloudflared-darwin-arm64"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png",
      "extraResources": [
        {
          "from": "resources/bin/cloudflared-win-x64.exe",
          "to": "bin/cloudflared-win-x64.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ConeCode"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "selfsigned": "^5.5.0",
    "uuid": "^11.1.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^42.11.3",
    "electron-builder": "^26.16.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
